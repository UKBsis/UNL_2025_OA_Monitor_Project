Load distinct
  ISSN_L as ISSN_L_Final 
 ,APC  as  APC_Final
 ,DOAJ_ISSN as DOAJ_ISSN_Final 
Resident DOAJ
where len(ISSN_L) > 2;

Left Join(Final_Temp)
Load
 Upper(doi) as doi,
 
if(len(trim(url_for_landing_page_concat)) > 0,
    url_for_landing_page_concat,
    if(len(trim(best_oa_url_for_pdf_concat)) > 0,
        best_oa_url_for_pdf_concat,
        url_for_pdf_concat
    )
)                                           as url_for_landing_page

 ,lower(UPW_DOI.oa_status_temp)             as UPW_DOI.oa_status_Final
 ,UPW_DOI.UPW_doi                           as UPW_doi_Final
 ,repository_institution_concat             as repository_institution_Final
 ,host_type_concat  						as host_type_Final
 ,url_for_pdf_concat 					    as url_for_pdf_Final
Resident UPW_DOI;

Final_Temp2:
NoConcatenate 
Load distinct
*
 ,if(not isnull(DOAJ_ISSN_Final), 'true','false') as DOAJ_included 
 ,if(not isnull(UPW_doi_Final), 'true','false') as UPW_included 
 //Step 1 Business Rule:
 ,if(ISSN_L_Final = DOAJ_ISSN_Final, 'A' 
 ,if(match([UPW_DOI.oa_status_Final],'gold','hybrid'), 'B' 
 ,if(match(UPW_DOI.oa_status_Final,'green'), 'C'
 ,if(match(UPW_DOI.oa_status_Final, 'bronze','closed'), 'D'
 ,url_for_landing_page
 ))))  as "Step 1 OA Category BR (automated)"  // Front end field label : "OA category (automated)"
 ,if(match([UPW_DOI.oa_status_Final],'gold','hybrid'), 'B' 
 ,if(match(UPW_DOI.oa_status_Final,'green'), 'C'
 ,if(match(UPW_DOI.oa_status_Final, 'bronze','closed'), 'D'
 ))) as "UPW Category Result"
Resident Final_Temp;
