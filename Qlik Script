Sub SURF

// Below is the addition of the SURF Metadata Hub Publisher Report DOIs and metadata to the datamodel 
// to be taken into consideration in the Final Business rule for Category classification

Set vTimeStamp = '21-07-2026'; // timestamp for our use of SURF Metadat Hub as a "data source"
Set vPathQVD   = 'lib://UKBSIS_QVD/2.20 Monitoring/Snapshot/OA UNL Monitor 2026';

//  SURF Metadata Hub OA Status as comparison for final OA status
SURF:
Qualify * ;
Unqualify doi;
Load Distinct
   Upper(DOI) as doi
  ,DOI 
  ,[BR_OA_Status] as [BR_OA_Status_temp]
  ,[UPW DOI url]
From
[$(vPathQVD)/#Publications_$(vTimeStamp).qvd] (qvd)
//only use Publisher Report DOIs
Where
	[Flag Source DOI] <= 16
    AND [Article PR_OAS_SOURCE]='PR'
    OR [Article PR_OAS_SOURCE] ='PR OAS'
    AND [Article PR_OAS_SOURCE]<>'OAS'
    ;
Unqualify *;    
// To Create a link between DOI and Journal use the FACTS table from SURF
FACTS:
Left Join (SURF)
LOAD Distinct
Upper(DOI)         as doi
,Journals_ID       as SURF_Journals_ID
From
[$(vPathQVD)/FACTS_$(vTimeStamp).qvd] (qvd);

// For the distinction between Cat A or B for gold status, determine if we have found the ISSN in DOAJ
SURF_DOAJ:
Left Join (SURF)
LOAD Distinct
    Journals_ID       as SURF_Journals_ID               
  ,[Journal Source]   as SURF_Journals_Source
From
[$(vPathQVD)/#Journals_$(vTimeStamp).qvd] (qvd)
where match([Journal Source],'DOAJ')
;


SURF_Final:
NoConcatenate
Load distinct
  doi
 ,SURF.DOI
 ,[SURF.BR_OA_Status_temp]
 ,if(match([SURF.BR_OA_Status_temp],'Gold open access','Hybrid open access'), 'B' 
    ,[SURF.BR_OA_Status_temp]) as [Step 2a SURF.BR_OA_Status]
 ,SURF_Journals_Source
 ,[SURF.UPW DOI url]
Resident SURF;

Drop Table SURF;
End Sub

