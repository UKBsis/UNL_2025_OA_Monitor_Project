// only compare the OA Monitor project DOIs with the SURF Unpaywall URLs
left Join (Final_Temp2)
Load Distinct
 doi,
 SURF.DOI,
 [Step 2a SURF.BR_OA_Status], //Front end field label : "Metadatahub PR Score"
 SURF_Journals_Source,
 [SURF.UPW DOI url]
Resident SURF_Final;

//Returned "C" Results from Institutes
left Join(Final_Temp2)
Load Distinct
 Return_Link
,SubField(Return_Link,'_',1) as Returned_by_institute
,if(len("OA category according to institute")<1, null(), "OA category according to institute") as "Step 2b OA category according to institute"
,"URL by institute" as "Step 2b Updated URL by institute (manual)"
Resident Cris_Final;



SURF_Result:
Qualify *;
Unqualify doi;
left join (Final_Temp2)
Load *
Resident SURF_Final;
Unqualify * ;

Drop Table SURF_Final;

CategoryRankMap:
MAPPING LOAD * INLINE [
    Category, Rank
    A, 1
    B, 2
    C, 3
    D, 4
];

Final:
NoConcatenate
Load
*,
 ApplyMap('CategoryRankMap', "Step 1 OA Category BR (automated)",999) as "Step 1 Rank",
 ApplyMap('CategoryRankMap', "Step 2a SURF.BR_OA_Status",999) as "Step 2a Rank",
 ApplyMap('CategoryRankMap', "Step 2b OA category according to institute",999) as "Step 2b Rank"

Resident Final_Temp2;
Drop Table Final_Temp2;


//Award ranks to be able to award the highest rank to a DOI if that falls within the business rule
Ranked:
Left Join (Final)

LOAD distinct
    doi,
    sum([Step 2a Rank]) as SumRank2a,  // SURF
    sum([Step 2b Rank]) as SumRank2b,  // Institute
    sum([Step 1 Rank]) as SumRank1,    // Initial Auto Business Rule
    FirstSortedValue(Distinct "Step 1 OA Category BR (automated)", [Step 1 Rank]) as Sorted1Category,
    FirstSortedValue(Distinct "Step 2a SURF.BR_OA_Status", [Step 2a Rank]) as Sorted2aCategory,
    FirstSortedValue(Distinct "Step 2b OA category according to institute", [Step 2b Rank]) as Sorted2bCategory

RESIDENT Final
GROUP BY doi
;

// Final Business Rule for combined results:

// Award Category A for only for DOIs that have an A in "Step 1 OA Category BR (automated)" 
// as these DOIs' ISSNs were found in DOAJ (ISSNs harvested from CrossRef and sent through the mapping of ISSN.org).

// Next if the DOI has not been found in DOAJ, but found in the set of SURF Metadata Hub with Gold or Hybrid OA Status
// (only taking into consideration the SURF DOIs that were reported by the Publishers directly)
// a B is awarded as these were checked by SURF

// If none of the above criteria were met, the DOI's Category awarded by the institutes themselves (C) are taken 
// into consideration should there be URL evidence provided. 

// PR OA status or DOAJ A/B> Unpaywall A / B > Institute C > Unpaywall C / D
// So, if an institute scores the DOI a C but DOAJ, PR OA or unpaywall states it's an A or B, 
// than the institutional info should be overwritten. 
// In the dashboard you should see the final merged score (based on DOAJ, PR OA or Unpaywall) including the link to the publication if the initial automated score was overwritten

LEFT JOIN (Final)
LOAD distinct
doi,
if (match("Step 1 OA Category BR (automated)",'A'), "Step 1 OA Category BR (automated)",
if (match(Sorted1Category,'B')   ,Sorted1Category,
if (match(Sorted2aCategory,'B')  ,Sorted2aCategory,
if (match(Sorted2bCategory,'C')  ,Sorted2bCategory
,Sorted1Category))))             as "Step 3 Merged" // Front end field label: "'Last step Merged Business rule OA category according to institute / Metadathub (manual)'"

Resident Final;
;

Left join (Final)
Load
doi
,concat (DISTINCT "Step 2b Updated URL by institute (manual)", ' , ') as "URL by institute (concat)"
Resident Final
Group by doi;

Final_Export:
NoConcatenate Load *
,doi as final_doi
,If(len("URL by institute (concat)")<1 or isnull("URL by institute (concat)"), 
    url_for_landing_page,"URL by institute (concat)") as [Merged URL UPW or Institite_temp]
,ApplyMap('CategoryRankMap',"Step 3 Merged",999) as "Step 3 Rank"
Resident Final
;


