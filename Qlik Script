Sub UKBsis

// Below is the addition of the UKBsis Publisher Report DOIs and metadata to the datamodel 
// to be taken into consideration in the Final Business rule for Category classification

Set vTimeStamp = '30-07-2025'; //  date /timestamp for our use of UKB as a "data source"
Set vPathQVD   = 'lib://UKBSIS_QVD/2.20 Monitoring/Snapshot/New/OA Monitor Snapshots';


//  UKBsis Datahub OA Status as comparison for final OA status
UKBsis:
Qualify * ;
Unqualify doi;
Load Distinct
   Upper(DOI) as doi
  ,DOI 
  ,[BR_OA_Status] as [BR_OA_Status_temp]
  ,[UPW DOI url]
From
[$(vPathQVD)/#Publications_$(vTimeStamp).qvd] (qvd)
//only use Publisher Report DOIs
Where
	[Flag Source DOI] <= 16
    AND [Article PR_OAS_SOURCE]='PR'
    OR [Article PR_OAS_SOURCE] ='PR OAS'
    AND [Article PR_OAS_SOURCE]<>'OAS'
    ;
Unqualify *;    
// To Create a link between DOI and Journal use the FACTS table from UKBsis
FACTS:
Left Join (UKBsis)
LOAD Distinct
 Upper(DOI) as doi
,Journals_ID       as UKB_Journals_ID
From
[$(vPathQVD)/FACTS_$(vTimeStamp).qvd] (qvd);

// For the distinction between Cat A or B for gold status, determine if we have found the ISSN in DOAJ
// which will mean a Category A awarded

UKB_DOAJ:
Left Join (UKBsis)
LOAD Distinct
  Journals_ID       as UKB_Journals_ID               
  ,"Journal Source" as UKB_Journals_Source
From
[$(vPathQVD)/#Journals_$(vTimeStamp).qvd] (qvd)
where match("Journal Source",'DOAJ')
;

UKBsis_Final:
NoConcatenate
Load distinct
 doi
 ,UKBsis.DOI
 ,[UKBsis.BR_OA_Status_temp]
 ,if(match([UKBsis.BR_OA_Status_temp],'Gold open access','Hybrid open access'), 'B'
  ) as [Step 2a UKBsis.BR_OA_Status]
 ,UKB_Journals_Source
 ,"UKBsis.UPW DOI url"
Resident UKBsis;

Drop Table UKBsis;

End Sub

