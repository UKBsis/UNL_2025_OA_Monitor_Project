Sub CRIS

// Below received sets of DOIs and metadata received as per template
// provided from participating institutes

Cris_Final:
LOAD 1 AS X AUTOGENERATE 0;

FOR EACH csvFile IN FileList('lib://UKBsis_XLS/1.2025 OA Monitor Project 2025/*2025*.csv')

    TRACE Processing $(csvFile);

    // Try comma
    Temp:
    LOAD *
    FROM [$(csvFile)]
    (txt, utf8, embedded labels, delimiter is ',', msq);

    IF NoOfFields('Temp') = 1 THEN

        DROP TABLE Temp;

    // Retry semicolon
        Temp:
        LOAD *
        FROM [$(csvFile)]
        (txt, utf8, embedded labels, delimiter is ';', msq);

    ENDIF

    CONCATENATE (Cris_Final)
    LOAD *
    ,'$(csvFile)' as FileName
    RESIDENT Temp;

    DROP TABLE Temp;

NEXT csvFile;

