left Join (Final_Temp2)
Load Distinct
 doi,
 UKBsis.DOI,
 "Step 2a UKBsis.BR_OA_Status",
 UKB_Journals_Source,
 "UKBsis.UPW DOI url"
Resident UKBsis_Final;

//Returned Results from Institutes
left Join(Final_Temp2)
Load Distinct
Returned.Return_Link as Return_Link
,SubField(Returned.Return_Link,'_',1) as Returned_by_institute
,"Returned.Step 2b OA category according to institute (manual)" as "Step 2b OA category according to institute_temp" 
,"Returned.Updated URL by institute (manual)" as "Step 2b Updated URL by institute (manual)"

Resident Returned
;

//Returned URLs concatenated received from Institutes
left Join(Final_Temp2)
Load Distinct
doi
,Concat(distinct "Returned.Updated URL by institute (manual)",' | ') as "Concat Step 2b Updated URL by institute (manual)"
Resident Returned
Group By doi
; 


left Join(Final_Temp2)
Load Distinct
Return_Link
,if(isnull("Step 2b OA category according to institute_temp"),
   "Step 1 OA Category BR (automated)","Step 2b OA category according to institute_temp") 
   as "Step 2b OA category according to institute"
 
Resident Final_Temp2;
 
 
Drop Table UKBsis_Final;

CategoryRankMap:
MAPPING LOAD * INLINE [
    Category, Rank
    A, 1
    B, 2
    C, 3
    D, 4
];

Final:
NoConcatenate
Load
*,
 ApplyMap('CategoryRankMap', "Step 1 OA Category BR (automated)",999) as "Step 1 Rank",
 ApplyMap('CategoryRankMap', "Step 2a UKBsis.BR_OA_Status",999) as "Step 2a Rank",
 ApplyMap('CategoryRankMap', "Step 2b OA category according to institute",999) as "Step 2b Rank"

Resident Final_Temp2;
Drop Table Final_Temp2;


//Award ranks to be able to award the highest rank to a DOI if that falls within the business rule
Ranked:
Left Join (Final)

LOAD distinct
    doi,
    sum([Step 2a Rank]) as SumRank2a,  //UKB
    sum([Step 2b Rank]) as SumRank2b,  //Institute
    sum([Step 1 Rank]) as SumRank1,    // Initial Auto Business Rule
    FirstSortedValue(Distinct "Step 2b OA category according to institute", [Step 2b Rank]) as Sorted2bCategory
RESIDENT Final
GROUP BY doi
;

// Final Business Rule for combined results:

// Award Category A for only for DOIs that have an A in "Step 1 OA Category BR (automated)" 
// as these DOIs' ISSNs were found in DOAJ (ISSNs harvested from CrossRef and sent through the mapping of ISSN.org).

// Next if the DOI has not been found in DOAJ, but found in the set of UKBsis Datahub 
// (only taking into consideration the UKBsis DOIs that were reported by the Publishers directly)
// a B is awarded as these were checked by UKBsis

// If none of the above criteria were met, the DOI's Category awarded by the institutes themselves are taken 
// into consideration should there be URL evidence provided (the highest rank i.e B over C if reported by more than
// one institution. A's can only be awarded here if there were no ISSNs found within Crossref and there is 
// therefore no search possible within DOAJ



LEFT JOIN (Final)
LOAD distinct
doi,
if(match("Step 1 OA Category BR (automated)",'A'), "Step 1 OA Category BR (automated)",
    if(not match("Step 1 OA Category BR (automated)",'A') and not isnull("Step 2a UKBsis.BR_OA_Status"),
    "Step 2a UKBsis.BR_OA_Status",
   If (Match("Sorted2bCategory",'A') and not isnull(ISSN_L_Final),"Step 1 OA Category BR (automated)",
    
"Sorted2bCategory"
  

))) as "Step 3 Merged"


Resident Final;
;

Final_Export:
NoConcatenate Load *,
ApplyMap('CategoryRankMap',"Step 3 Merged",999) as "Step 3 Rank"
Resident Final;

Drop table Final;
Drop fields 
 doi
 ,Institutional_identifier_concat
 ,Institutional_identifier_concat_inst from Cris_Final;

End Sub

